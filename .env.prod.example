# Plantilla para producción / web:
#   docker compose --env-file .env.prod up -d --build
# (usa docker-compose.yml — canónico del servidor)
# NO commitear .env.prod con secretos reales.

DEBUG=False
SECRET_KEY=cambiar-por-secreto-largo-aleatorio
ALLOWED_HOSTS=tu-dominio.com
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com
PUBLIC_BASE_URL=https://tu-dominio.com
ADMIN_URL=admin/
PORT=8000
WEB_CONCURRENCY=2
DATOS_PERSONALES_CONTACTO=protecciondatos@ucundinamarca.edu.co

# Postgres del compose prod (no publicar puerto al host)
POSTGRES_DB=sistema_control
POSTGRES_USER=sistema_control
POSTGRES_PASSWORD=cambiar-password-fuerte

# Resend (obligatorio en prod — sin mock)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@dominio-verificado.com
RESEND_FROM_NAME=Control de Equipos UCundinamarca
RESEND_MOCK_MODE=False
RESEND_WEBHOOK_SECRET=
EMAIL_TOKEN_SECRET=

# MVP sync (el compose prod ya fuerza estos valores)
EMAIL_USE_CELERY=False
CELERY_TASK_ALWAYS_EAGER=True
