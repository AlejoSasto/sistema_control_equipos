DEBUG=True
SECRET_KEY=cambiar-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes HTTPS/HTTP confiables para CSRF (producción Render: https://TU-SERVICIO.onrender.com)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ADMIN_URL=admin/
# Preferido en Docker/Render (si está definido, ignora DB_*):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DB_NAME=sistema_control
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432
PORT=8000
QR_DISPLAY_TOKEN_MAX_AGE=300
DATOS_PERSONALES_CONTACTO=protecciondatos@ucundinamarca.edu.co

# --- Resend (correos transaccionales) ---
# API key: Resend → API Keys → Create API Key (re_...)
RESEND_API_KEY=
# Remitente con dominio verificado en Resend (ej. noreply@aura-tech-solution.com)
RESEND_FROM_EMAIL=noreply@aura-tech-solution.com
RESEND_FROM_NAME=Control de Equipos UCundinamarca
# True = mock local; False = API real
RESEND_MOCK_MODE=True
# Signing secret del webhook (whsec_...) — se crea en Resend → Webhooks
RESEND_WEBHOOK_SECRET=
# Base de enlaces en correos (sin barra final)
PUBLIC_BASE_URL=https://sistema-control-web.onrender.com
# Opcional; por defecto SECRET_KEY
EMAIL_TOKEN_SECRET=

# --- Celery / Redis (opcional en local si RESEND_MOCK_MODE=True + DEBUG) ---
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=True
