DEBUG=True
SECRET_KEY=cambiar-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1
# Local + (opcional) origen Render; en prod Render usar solo https://sistema-control-web.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ADMIN_URL=admin/
# Preferido en Docker/Render (si está definido, ignora DB_*):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DB_NAME=sistema_control
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432
PORT=8000
QR_DISPLAY_TOKEN_MAX_AGE=300
DATOS_PERSONALES_CONTACTO=protecciondatos@ucundinamarca.edu.co

# --- Resend (correos transaccionales) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@aura-tech-solution.com
RESEND_FROM_NAME=Control de Equipos UCundinamarca
# Local: True (mock). Pruebas reales: False + API key; recrear contenedores.
# Si Resend marca delivered y no ves el correo: spam / cuarentena institucional.
RESEND_MOCK_MODE=True
RESEND_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
EMAIL_TOKEN_SECRET=

# MVP: False = envío síncrono en el web (sin Redis/worker). Fase 2: True + Celery.
# Local (docker-compose.prod.yml) por defecto usa Celery+worker; override aquí si quieres sync.
EMAIL_USE_CELERY=False
CELERY_TASK_ALWAYS_EAGER=True

# Local Docker:
#   docker compose -f docker-compose.prod.yml up --build
# Prod / web (docker-compose.yml canónico):
#   docker compose --env-file .env.prod up -d --build
# Ver .env.prod.example

# --- Celery / Redis (solo si EMAIL_USE_CELERY=True) ---
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
